<?xml version="1.0" ?>
<!-- Phase 0 tunnel world. Site file: configs/sim/tunnel_site.yaml -->
<sdf version="1.9">
  <world name="phase0_tunnel_gate">
    <physics type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
    </physics>
    <plugin name="gz::sim::systems::Physics" filename="gz-sim-physics-system"/>
    <plugin name="gz::sim::systems::UserCommands" filename="gz-sim-user-commands-system"/>
    <plugin name="gz::sim::systems::SceneBroadcaster" filename="gz-sim-scene-broadcaster-system"/>
    <plugin name="gz::sim::systems::Contact" filename="gz-sim-contact-system"/>
    <plugin name="gz::sim::systems::Imu" filename="gz-sim-imu-system"/>
    <plugin name="gz::sim::systems::AirPressure" filename="gz-sim-air-pressure-system"/>
    <plugin name="gz::sim::systems::Sensors" filename="gz-sim-sensors-system">
      <render_engine>ogre2</render_engine>
    </plugin>

    <gravity>0 0 -9.80665</gravity>
    <magnetic_field>6e-06 2.3e-05 -4.2e-05</magnetic_field>
    <atmosphere type="adiabatic"/>
    <scene>
      <grid>false</grid>
      <ambient>0.3 0.3 0.3 1</ambient>
      <background>0.05 0.05 0.05 1</background>
      <shadows>true</shadows>
    </scene>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <!-- ground_plane removed (tunnel_site.ground_plane=false); the tube floor is the floor. -->

    <!-- SubT tunnel segment (local mesh; no Fuel dependency) -->
    <model name="tunnel_segment">
      <static>true</static>
      <pose>28.000000 -64.662384 -143.817011 1.570796 0.000000 -3.141593</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <mesh>
              <uri>model://cave_world/meshes/lava_tube.obj</uri>
            </mesh>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <mesh>
              <uri>model://cave_world/meshes/lava_tube.obj</uri>
            </mesh>
          </geometry>
        </visual>
      </link>
    </model>
  
    <model name="launch_pad">
      <static>true</static>
      <pose>1.500000 0.000000 -0.020000 0 0 0.000000</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box><size>4.000000 1.900000 0.060001</size></box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box><size>4.000000 1.900000 0.060001</size></box>
          </geometry>
          <material>
            <ambient>0.5 0.5 0.55 1</ambient>
            <diffuse>0.6 0.6 0.65 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
  </world>
</sdf>
